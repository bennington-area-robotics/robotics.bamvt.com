#!/usr/bin/env ruby
# Refresh _data/ftc_events/<season>.json from the public FTC events listing.
#
#   bin/ftc-events                 # season 2026 -> _data/ftc_events/2026-2027.json
#   bin/ftc-events 2027            # a later season
#   bin/ftc-events 2026 saved.html # parse a saved copy of the listing page
#
# The listing at https://ftc-events.firstinspires.org/<season> embeds every
# event as JSON. This keeps New England, New York, New Jersey, and Pennsylvania
# events, normalizes field names, fills missing coordinates from VENUES, and
# applies CORRECTIONS confirmed against regional organizers.
require 'json'
require 'net/http'
require 'time'

STATES = %w[CT MA ME NH RI VT NY NJ PA].freeze

TYPES = {
  0 => 'Scrimmage',
  1000 => 'League Meet',
  1001 => 'League Tournament',
  1004 => 'Qualifier',
  1007 => 'Super Qualifier',
  1010 => 'Championship',
  1016 => 'Kickoff',
  1017 => 'Premier Event'
}.freeze

# Venue coordinates for events FIRST publishes without a location, keyed by
# "<season>/<code>" because codes repeat across seasons. Sources: OpenStreetMap
# (Nominatim) venue lookups, 2026-11-04.
VENUES = {
  '2026/USNJCENM5' => [40.62012, -74.56772], # The Pingry School, Basking Ridge
  '2026/USNJNEM5' => [40.67173, -74.12247],  # Bayonne High School
  '2026/USNHWIN' => [42.79910, -71.30701],   # Windham Center School
  '2026/USNHWIQ' => [42.79910, -71.30701],   # Windham Center School
  '2026/USNYEXCOKO' => [42.17537, -76.88200], # Corning Robot Room, 3504 Chambers Rd, Big Flats
  '2026/USNYEXUTQ' => [43.07520, -75.21688], # MVCC Jorgensen Athletic Center
  '2026/USNYEXCMP' => [43.07520, -75.21688], # MVCC Jorgensen Athletic Center
  '2026/USNYEXPOQ' => [44.66232, -74.99868]  # Clarkson University Schuler ERC
}.freeze

# City-level coordinates when no venue location is known. Events placed this way
# are flagged location_approximate.
FALLBACK = {}.freeze

# Corrections where the regional organizer's published details differ from
# FIRST's record, keyed like VENUES.
CORRECTIONS = {
  # https://www.ftcpenn.org/ftc-events/2026-2027-season/pennsylvania-ftc-season-kickoff-exton
  '2026/USPAEXKO' => {
    'venue' => 'Downingtown Area Robotics Meeting Space',
    'address' => '241 Welsh Pool Rd, Suite 110',
    'lat' => 40.06214, 'lon' => -75.64403
  }
}.freeze

VIRTUAL = /\A(virtual|remote|online)\b/i

season = Integer(ARGV[0] || 2026)
url = "https://ftc-events.firstinspires.org/#{season}"
html = if ARGV[1]
         File.read(ARGV[1])
       else
         res = Net::HTTP.get_response(URI(url))
         abort "Fetching #{url} failed: #{res.code}" unless res.is_a?(Net::HTTPSuccess)
         res.body.force_encoding('UTF-8')
       end

def embedded(html, name)
  start = html.index(/window\.#{name}\s*=\s*/) or abort "window.#{name} not found"
  start = html.index('[', start)
  depth = 0
  in_str = false
  esc = false
  (start...html.length).each do |i|
    c = html[i]
    if in_str
      if esc then esc = false
      elsif c == '\\' then esc = true
      elsif c == '"' then in_str = false
      end
    elsif c == '"' then in_str = true
    elsif c == '[' || c == '{' then depth += 1
    elsif c == ']' || c == '}'
      depth -= 1
      return JSON.parse(html[start..i]) if depth.zero?
    end
  end
  abort "window.#{name} is not terminated"
end

groups = %w[KickoffEvents OtherEvents DistrictChampionshipWeek FIRSTChampionshipWeek OffSeasonEvents PremierEvents]
raw = groups.flat_map { |g| embedded(html, g).flat_map { |week| week['E'] } }

seen = {}
events = raw.filter_map do |e|
  next unless e['Ect'] == 'USA' && STATES.include?(e['Es'])
  next if seen[e['Tc']]

  seen[e['Tc']] = true
  key = "#{season}/#{e['Tc']}"
  city = e['Ec'].to_s.strip
  state = e['Es']
  # FIRST sometimes appends " ()  City, ST" or a trailing comma to venue names.
  venue = e['Ev'].to_s.sub(/\s*\(\s*\).*\z/, '').strip.sub(/,\z/, '').squeeze(' ')
  address = e['Ea'].to_s.strip.sub(/,\z/, '').squeeze(' ')
  # The listing stores longitude in "lat" and latitude in "lon".
  lat = e['lon']
  lon = e['lat']
  # Without a published venue, FIRST's coordinates are only a city centroid.
  approximate = venue.empty? || venue == '-'
  if lat.nil? || lon.nil?
    lat, lon = VENUES[key]
    approximate = lat.nil?
    lat, lon = FALLBACK["#{city}, #{state}"] if lat.nil?
    warn "No coordinates for #{key} (#{city}, #{state}); add the venue to VENUES" if lat.nil?
  end
  correction = CORRECTIONS.fetch(key, {})
  website = e['Ew'].to_s.strip
  {
    'code' => e['Tc'],
    'name' => e['En'].to_s.strip.squeeze(' '),
    'type' => TYPES.fetch(e['eventType'], "Other (#{e['eventType']})"),
    'start' => e['Sd'][0, 10],
    'end' => e['Ed'][0, 10],
    'venue' => venue,
    'address' => address,
    'city' => city,
    'state' => state,
    'region' => e['Rn'],
    'website' => website.empty? ? nil : website,
    'ftc_events_url' => "https://ftc-events.firstinspires.org/#{season}/#{e['Tc']}",
    'lat' => lat,
    'lon' => lon,
    'location_approximate' => approximate,
    'remote' => e['Isr'] || venue.match?(VIRTUAL),
    'hybrid' => e['IsHybrid']
  }.merge(correction)
end

used = events.map { |e| "#{season}/#{e['code']}" }
(VENUES.keys + CORRECTIONS.keys).select { |k| k.start_with?("#{season}/") && !used.include?(k) }.each do |k|
  warn "#{k} is in VENUES or CORRECTIONS but no longer in the listing; remove it"
end

events.sort_by! { |e| [e['start'], e['state'], e['name']] }

data = {
  'season' => "#{season}-#{season + 1}",
  'source' => url,
  'retrieved' => Time.now.getlocal('-05:00').strftime('%Y-%m-%d'), # Eastern (standard) date
  'states' => STATES,
  'events' => events
}

path = File.expand_path("../_data/ftc_events/#{season}-#{season + 1}.json", __dir__)
Dir.mkdir(File.dirname(path)) unless Dir.exist?(File.dirname(path))
File.write(path, JSON.pretty_generate(data) + "\n")
puts "Wrote #{events.size} events to #{path}"
