#!/usr/bin/env ruby
# Refresh _data/ftc_events/<season>.json from the FTC Events API.
#
#   bin/ftc-events        # season 2026 -> _data/ftc_events/2026-2027.json
#   bin/ftc-events 2027   # a later season
#
# Needs FTC_API_USERNAME and FTC_API_TOKEN (see bin/lib/ftc_api.rb). Keeps New
# England, New York, New Jersey, and Pennsylvania events, normalizes field names,
# fills missing coordinates from VENUES, and applies CORRECTIONS confirmed
# against regional organizers.
require 'json'
require 'time'
require_relative 'lib/ftc_api'

STATES = %w[CT MA ME NH RI VT NY NJ PA].freeze

# The API's typeName, renamed where the map uses a shorter or plainer label.
TYPE_NAMES = {
  'Non-Advancement' => 'Scrimmage',
  'Demo / Exhibition' => 'Demo'
}.freeze

# Venue coordinates for events the API publishes without coordinates, keyed by
# "<season>/<code>" because codes repeat across seasons. Sources: OpenStreetMap
# (Nominatim) venue lookups, 2026-11-04.
VENUES = {
  '2026/USNJCENM5' => [40.62012, -74.56772], # The Pingry School, Basking Ridge
  '2026/USNJNEM5' => [40.67173, -74.12247],  # Bayonne High School
  '2026/USNHWIN' => [42.79910, -71.30701],   # Windham Center School
  '2026/USNHWIQ' => [42.79910, -71.30701],   # Windham Center School
  '2026/USNYEXCOKO' => [42.17537, -76.88200], # Corning Robot Room, 3504 Chambers Rd, Big Flats
  '2026/USNYEXUTQ' => [43.07520, -75.21688], # MVCC Jorgensen Athletic Center
  '2026/USNYEXCMP' => [43.07520, -75.21688], # MVCC Jorgensen Athletic Center
  '2026/USNYEXPOQ' => [44.66232, -74.99868]  # Clarkson University Schuler ERC
}.freeze

# City-level coordinates when no venue location is known. Events placed this way
# are flagged location_approximate.
FALLBACK = {}.freeze

# Corrections where the regional organizer's published details differ from
# FIRST's record, keyed like VENUES.
CORRECTIONS = {
  # https://www.ftcpenn.org/ftc-events/2026-2027-season/pennsylvania-ftc-season-kickoff-exton
  '2026/USPAEXKO' => {
    'venue' => 'Downingtown Area Robotics Meeting Space',
    'address' => '241 Welsh Pool Rd, Suite 110',
    'lat' => 40.06214, 'lon' => -75.64403
  }
}.freeze

VIRTUAL = /\A(virtual|remote|online)\b/i

season = Integer(ARGV[0] || 2026)
raw = FtcApi.get("#{season}/events").fetch('events')

events = raw.filter_map do |e|
  next unless e['country'] == 'USA' && STATES.include?(e['stateprov'])

  key = "#{season}/#{e['code']}"
  city = e['city'].to_s.strip
  state = e['stateprov']
  # FIRST sometimes appends " ()  City, ST" or a trailing comma to venue names.
  venue = e['venue'].to_s.sub(/\s*\(\s*\).*\z/, '').strip.sub(/,\z/, '').squeeze(' ')
  address = e['address'].to_s.strip.sub(/,\z/, '').squeeze(' ')
  # GeoJSON order: [longitude, latitude].
  lon, lat = e.dig('coordinates', 'coordinates')
  # Without a published venue, FIRST's coordinates are only a city centroid.
  approximate = venue.empty? || venue == '-'
  if lat.nil? || lon.nil?
    lat, lon = VENUES[key]
    approximate = lat.nil?
    lat, lon = FALLBACK["#{city}, #{state}"] if lat.nil?
    warn "No coordinates for #{key} (#{city}, #{state}); add the venue to VENUES" if lat.nil?
  elsif VENUES.key?(key)
    warn "#{key}: the API now has coordinates; remove it from VENUES"
  end
  correction = CORRECTIONS.fetch(key, {})
  website = e['website'].to_s.strip
  {
    'code' => e['code'],
    'name' => e['name'].to_s.strip.squeeze(' '),
    'type' => TYPE_NAMES.fetch(e['typeName'], e['typeName']),
    'start' => e['dateStart'][0, 10],
    'end' => e['dateEnd'][0, 10],
    'venue' => venue,
    'address' => address,
    'city' => city,
    'state' => state,
    'region' => e['regionCode'],
    'website' => website.empty? ? nil : website,
    'ftc_events_url' => "https://ftc-events.firstinspires.org/#{season}/#{e['code']}",
    'lat' => lat&.round(5),
    'lon' => lon&.round(5),
    'location_approximate' => approximate,
    'remote' => e['remote'] || venue.match?(VIRTUAL),
    'hybrid' => e['hybrid']
  }.merge(correction)
end

used = events.map { |e| "#{season}/#{e['code']}" }
(VENUES.keys + CORRECTIONS.keys).select { |k| k.start_with?("#{season}/") && !used.include?(k) }.each do |k|
  warn "#{k} is in VENUES or CORRECTIONS but no longer in the API; remove it"
end

events.sort_by! { |e| [e['start'], e['state'], e['name']] }

data = {
  'season' => "#{season}-#{season + 1}",
  'source' => FtcApi::INFO_URL,
  'retrieved' => Time.now.getlocal('-05:00').strftime('%Y-%m-%d'), # Eastern (standard) date
  'states' => STATES,
  'events' => events
}

path = File.expand_path("../_data/ftc_events/#{season}-#{season + 1}.json", __dir__)
Dir.mkdir(File.dirname(path)) unless Dir.exist?(File.dirname(path))
File.write(path, JSON.pretty_generate(data) + "\n")
puts "Wrote #{events.size} events to #{path}"
