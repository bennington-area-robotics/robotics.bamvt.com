#!/usr/bin/env ruby
# Refresh _data/ftc_teams/<season>.json from the FTC Events API.
#
#   bin/ftc-teams          # season 2026 -> _data/ftc_teams/2026-2027.json
#   bin/ftc-teams 2027     # a later season
#
# Needs FTC_API_USERNAME and FTC_API_TOKEN (see bin/lib/ftc_api.rb). FIRST
# publishes each team's town, not an address, so teams are mapped at the town
# level and only the number, short name, town, region, and rookie year are kept.
# Town coordinates come from OpenStreetMap Nominatim (at most one request per
# second) and are kept in the output's "places" table, so later runs only look up
# towns that are new.
require 'json'
require 'net/http'
require 'time'
require_relative 'lib/ftc_api'

STATES = %w[CT MA ME NH RI VT NY NJ].freeze
STATE_NAMES = {
  'CT' => 'Connecticut', 'MA' => 'Massachusetts', 'ME' => 'Maine', 'NH' => 'New Hampshire',
  'RI' => 'Rhode Island', 'VT' => 'Vermont', 'NY' => 'New York', 'NJ' => 'New Jersey'
}.freeze
USER_AGENT = 'robotics.bamvt.com ftc-teams refresh (https://robotics.bamvt.com/events/map/)'

season = Integer(ARGV[0] || 2026)
path = File.expand_path("../_data/ftc_teams/#{season}-#{season + 1}.json", __dir__)
previous = File.exist?(path) ? JSON.parse(File.read(path)) : {}
places = previous.fetch('places', {})

# Nominatim lookups only; FIRST data comes from the API.
def get(url)
  uri = URI(url)
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) do |http|
    http.request(Net::HTTP::Get.new(uri, 'User-Agent' => USER_AGENT))
  end
  abort "Fetching #{url} failed: #{res.code}" unless res.is_a?(Net::HTTPSuccess)
  res.body.force_encoding('UTF-8')
end

teams = STATES.flat_map do |state|
  page = 1
  rows = []
  loop do
    res = FtcApi.get("#{season}/teams", state: state, page: page)
    rows.concat(res.fetch('teams'))
    break if page >= res.fetch('pageTotal', 1)

    page += 1
  end
  warn "#{state}: no teams listed" if rows.empty?
  rows.filter_map do |r|
    next unless r['country'] == 'USA' && r['stateProv'] == state

    city = r['city'].to_s.strip.squeeze(' ')
    # Drop a repeated state ("East Greenwich RI") and keep the first of joint
    # towns ("Northborough/Southborough").
    city = city.sub(/,?\s+#{state}\z/, '').split('/').first.to_s.strip
    # Some towns are entered in capitals; title-case them so they group with others.
    city = city.split(/(\s+|-)/).map { |w| w.match?(/\A[A-Z]{2,}\z/) ? w.capitalize : w }.join if city == city.upcase
    { 'number' => r['teamNumber'], 'name' => r['nameShort'].to_s.strip.squeeze(' '), 'city' => city,
      'state' => state, 'region' => r['homeRegion'], 'rookie_year' => r['rookieYear'],
      'place' => "#{city}, #{state}" }
  end
end
teams = teams.uniq { |t| t['number'] }.sort_by { |t| t['number'] }

missing = teams.map { |t| t['place'] }.uniq - places.keys
warn "Looking up #{missing.size} new towns (about #{missing.size} seconds)" unless missing.empty?
missing.each do |place|
  city, state = place.split(', ')
  query = URI.encode_www_form(city: city, state: state, country: 'USA', format: 'json', limit: 1)
  hit = JSON.parse(get("https://nominatim.openstreetmap.org/search?#{query}")).first
  unless hit
    # Hamlets and villages often only match a free-text query.
    sleep 1.1
    free = URI.encode_www_form(q: "#{city}, #{state}", countrycodes: 'us', format: 'json', limit: 1)
    hit = JSON.parse(get("https://nominatim.openstreetmap.org/search?#{free}")).first
    warn "#{place}: matched #{hit['display_name']}; check it" if hit
  end
  if hit && !hit['display_name'].to_s.include?(STATE_NAMES[state])
    warn "#{place}: rejected a match outside #{STATE_NAMES[state]} (#{hit['display_name']})"
    hit = nil
  end
  if hit
    places[place] = [hit['lat'].to_f.round(5), hit['lon'].to_f.round(5)]
  else
    warn "No location found for #{place}; add it to \"places\" by hand"
  end
  sleep 1.1
end

used = teams.map { |t| t['place'] }.uniq
data = {
  'season' => "#{season}-#{season + 1}",
  'source' => FtcApi::INFO_URL,
  'retrieved' => Time.now.getlocal('-05:00').strftime('%Y-%m-%d'), # Eastern (standard) date
  'note' => 'Team locations are town centers from OpenStreetMap, not team addresses.',
  'places' => places.slice(*used).sort.to_h,
  'teams' => teams
}

Dir.mkdir(File.dirname(path)) unless Dir.exist?(File.dirname(path))
File.write(path, JSON.pretty_generate(data) + "\n")
puts "Wrote #{teams.size} teams in #{used.size} towns to #{path}"
